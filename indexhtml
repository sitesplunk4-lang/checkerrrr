<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cookie Checker</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: #050506; color: #ffffff; font-family: -apple-system, sans-serif; background-image: linear-gradient(rgba(139, 92, 246, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 92, 246, 0.03) 1px, transparent 1px); background-size: 40px 40px; min-height: 100vh; display: flex; justify-content: center; padding: 20px; }
        .container { width: 100%; max-width: 400px; }
        .header { margin-bottom: 20px; }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.3); color: #A78BFA; font-size: 10px; font-weight: bold; letter-spacing: 1px; margin-bottom: 10px; }
        h1 { font-size: 32px; font-weight: 800; line-height: 1.1; }
        .gradient-text { background: linear-gradient(to right, #C4B5FD, #7C3AED); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .panel { background: linear-gradient(145deg, rgba(15, 15, 20, 0.9), rgba(5, 5, 8, 0.95)); border: 1px solid rgba(139, 92, 246, 0.15); border-radius: 16px; padding: 20px; margin-bottom: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.8); }
        textarea { width: 100%; height: 100px; background: #000; color: #A78BFA; border: 1px solid #333; border-radius: 8px; padding: 12px; font-family: monospace; font-size: 12px; resize: none; margin-bottom: 15px; }
        textarea:focus { outline: none; border-color: #8B5CF6; }
        .file-upload { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; font-size: 12px; color: #888; }
        input[type="file"] { display: none; }
        .btn-file { background: rgba(139, 92, 246, 0.2); color: #A78BFA; padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(139, 92, 246, 0.3); cursor: pointer; font-weight: bold; }
        .btn-check { width: 100%; padding: 14px; background: linear-gradient(180deg, #A78BFA 0%, #7C3AED 100%); color: white; border: none; border-radius: 10px; font-weight: bold; font-size: 14px; cursor: pointer; box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4); transition: 0.2s; }
        .btn-check:disabled { opacity: 0.5; cursor: not-allowed; }
        .results { display: flex; flex-direction: column; gap: 10px; }
        .result-item { background: rgba(15, 15, 20, 0.6); border: 1px solid rgba(139, 92, 246, 0.1); padding: 12px; border-radius: 10px; font-size: 12px; }
        .valid { color: #4ade80; font-weight: bold; }
        .invalid { color: #f87171; font-weight: bold; }
        .loader { border: 2px solid #333; border-top: 2px solid #A78BFA; border-radius: 50%; width: 16px; height: 16px; animation: spin 1s linear infinite; display: inline-block; vertical-align: middle; margin-right: 8px; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="badge">🔒 ROBLOX UTILITY</div>
            <h1>Check with <br><span class="gradient-text">confidence.</span></h1>
        </div>
        <div class="panel">
            <div class="file-upload">
                <span>Upload file (.txt) / Paste:</span>
                <label for="fileInput" class="btn-file">📁 Pilih File</label>
                <input type="file" id="fileInput" accept=".txt">
            </div>
            <textarea id="textInput" placeholder="Format: user:pass:cookie atau paste cookie saja..."></textarea>
            <button id="btnCheck" class="btn-check" onclick="startCheck()">🚀 Check All</button>
        </div>
        <div class="results" id="results"></div>
    </div>
    <script>
        document.getElementById('fileInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) { document.getElementById('textInput').value = e.target.result; };
            reader.readAsText(file);
        });

        async function startCheck() {
            const btn = document.getElementById('btnCheck');
            const resultsDiv = document.getElementById('results');
            const text = document.getElementById('textInput').value;
            if (!text.trim()) return alert("Isi data dulu he!");
            btn.disabled = true;
            btn.innerHTML = '<span class="loader"></span> Processing...';
            resultsDiv.innerHTML = "";
            const lines = text.split('\n').filter(l => l.trim().length > 20);
            for (let i = 0; i < lines.length; i++) {
                let raw = lines[i].trim();
                let user = "Unknown", pass = "Unknown", c = raw;
                if (raw.includes(':')) {
                    const parts = raw.split(':');
                    if (parts.length >= 3) {
                        user = parts[0];
                        pass = parts[1];
                        c = parts.slice(2).join(':');
                    } else {
                        c = parts[parts.length - 1];
                    }
                }
                const div = document.createElement('div');
                div.className = 'result-item';
                div.innerHTML = `<span class="loader"></span> Checking <b>${user}</b>...`;
                resultsDiv.appendChild(div);
                try {
                    const res = await fetch('/api/check', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cookie: c, user: user, pass: pass })
                    });
                    const data = await res.json();
                    if (data.success) {
                        div.innerHTML = `<span class="valid">✅ ${data.account_info.username}</span><br>Robux: ${data.account_info.robux} | RAP: ${data.account_info.total_rap}`;
                    } else {
                        div.innerHTML = `<span class="invalid">❌ ${user}</span><br>${data.error}`;
                    }
                } catch (e) {
                    div.innerHTML = `<span class="invalid">❌ ${user}</span><br>Koneksi Error`;
                }
                await new Promise(r => setTimeout(r, 1500));
            }
            btn.disabled = false;
            btn.innerHTML = "✅ Selesai!";
        }
    </script>
</body>
</html>
